# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Email (dev: MailHog at localhost:1025, UI at localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="Munay <no-reply@munay.local>"

# Prisma — Docker Postgres from `docker compose up -d db` publishes 5434.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/palmera"

# Web3 — donations stay on Avalanche. Unlock may live on Sepolia during the demo.
NEXT_PUBLIC_DONATION_CHAIN_ID="43113"
NEXT_PUBLIC_UNLOCK_CHAIN_ID="11155111"
NEXT_PUBLIC_PRIVY_APP_ID=""
NEXT_PUBLIC_WALLETCONNECT_ID=""

# Unlock Protocol — one shared research Lock.
# Current demo lock is on Ethereum Sepolia (11155111 / sepolia.etherscan.io).
# Production can move both operations to Avalanche C-Chain (43114).
NEXT_PUBLIC_MUNAY_LOCK_ADDRESS=""

# Optional: one demo wallet that receives Fuji USDC for all communities.
# Leave empty to keep donation buttons disabled (zero treasury).
# DEMO_TREASURY_ADDRESS=""

# Optional
NEXT_PUBLIC_MAPBOX_TOKEN=""
